#!/bin/sh /etc/rc.common

# rc.common consumes these variables.
# shellcheck disable=SC2034
START=25
STOP=89

GADGET=/sys/kernel/config/usb_gadget/ufi001b
STATUS=/etc/ufi001b-usb-gadget.status

status() {
	printf '%s\n' "$*" >> "$STATUS"
}

record_link_state() {
	label="$1"
	operstate="$(cat /sys/class/net/usb0/operstate 2>/dev/null)"
	carrier="$(cat /sys/class/net/usb0/carrier 2>/dev/null)"
	master="$(readlink /sys/class/net/usb0/master 2>/dev/null)"
	status "$label usb0 operstate=${operstate:-missing} carrier=${carrier:-missing} master=${master##*/}"
	for interface in usb0 br-lan; do
		[ -e "/sys/class/net/$interface" ] || {
			status "$label $interface missing"
			continue
		}
		rx_bytes="$(cat "/sys/class/net/$interface/statistics/rx_bytes" 2>/dev/null)"
		tx_bytes="$(cat "/sys/class/net/$interface/statistics/tx_bytes" 2>/dev/null)"
		status "$label $interface rx=${rx_bytes:-missing} tx=${tx_bytes:-missing}"
		ip -4 -o addr show dev "$interface" >> "$STATUS" 2>&1 || true
	done
}

attach_lan_bridge() {
	label="$1"
	restart_lan="$2"
	if [ "$restart_lan" = 1 ]; then
		status "$label restarting lan after usb0 creation"
		ifdown lan >> "$STATUS" 2>&1 || status "$label ifdown lan failed"
	fi
	ifup lan >> "$STATUS" 2>&1 || status "$label ifup lan failed"
	tries=0
	while [ "$tries" -lt 10 ]; do
		[ -e /sys/class/net/br-lan ] && break
		tries=$((tries + 1))
		sleep 1
	done
	[ -e /sys/class/net/br-lan ] || {
		status "$label br-lan unavailable"
		return 1
	}
	ip link set dev usb0 master br-lan >> "$STATUS" 2>&1 || {
		status "$label attach usb0 to br-lan failed"
		return 1
	}
	ip link set dev br-lan up >> "$STATUS" 2>&1 || status "$label ip link set br-lan up failed"
	ip link set dev usb0 up >> "$STATUS" 2>&1 || {
		status "$label ip link set usb0 up failed"
		return 1
	}
}

board_is_ufi001b() {
	grep -qx 'handsome,openstick-ufi001b' /proc/device-tree/compatible 2>/dev/null ||
		tr '\0' '\n' </proc/device-tree/compatible 2>/dev/null |
		grep -qx 'handsome,openstick-ufi001b'
}

gadget_remove() {
	[ -d "$GADGET" ] || return 0
	[ ! -e "$GADGET/UDC" ] || printf '\n' > "$GADGET/UDC" 2>/dev/null || true
	rm -f "$GADGET/os_desc/c.1"
	rm -f "$GADGET/configs/c.1/rndis.usb0"
	rmdir "$GADGET/functions/rndis.usb0" 2>/dev/null || true
	rmdir "$GADGET/configs/c.1/strings/0x409" 2>/dev/null || true
	rmdir "$GADGET/configs/c.1" 2>/dev/null || true
	rmdir "$GADGET/strings/0x409" 2>/dev/null || true
	rmdir "$GADGET" 2>/dev/null || true
}

device_identity() {
	seed="$(cat /sys/devices/soc0/serial_number 2>/dev/null)"
	[ -n "$seed" ] || seed="$(tr -d '\0' </proc/device-tree/serial-number 2>/dev/null)"
	[ -n "$seed" ] || seed='ufi001b'
	hash="$(printf '%s' "$seed" | sha256sum | cut -c1-12)"
	USB_SERIAL="$(printf '%s' "$hash" | tr 'a-f' 'A-F')"
	DEV_MAC="02:$(printf '%s' "$hash" | cut -c1-2):$(printf '%s' "$hash" | cut -c3-4):$(printf '%s' "$hash" | cut -c5-6):$(printf '%s' "$hash" | cut -c7-8):$(printf '%s' "$hash" | cut -c9-10)"
	HOST_MAC="06:$(printf '%s' "$hash" | cut -c1-2):$(printf '%s' "$hash" | cut -c3-4):$(printf '%s' "$hash" | cut -c5-6):$(printf '%s' "$hash" | cut -c7-8):$(printf '%s' "$hash" | cut -c9-10)"
}

wait_for_udc() {
	tries=0
	while [ "$tries" -lt 30 ]; do
		UDC=
		for udc_path in /sys/class/udc/*; do
			[ -e "$udc_path" ] || continue
			UDC="${udc_path##*/}"
			break
		done
		[ -z "$UDC" ] || return 0
		tries=$((tries + 1))
		sleep 1
	done
	return 1
}

wait_for_usb0() {
	tries=0
	while [ "$tries" -lt 10 ]; do
		[ -e /sys/class/net/usb0 ] && return 0
		tries=$((tries + 1))
		sleep 1
	done
	return 1
}

start() {
	: > "$STATUS"
	status 'start'
	board_is_ufi001b || return 0
	modprobe libcomposite || {
		status 'modprobe libcomposite failed'
		return 1
	}
	modprobe usb_f_rndis || {
		status 'modprobe usb_f_rndis failed'
		return 1
	}
	mkdir -p /sys/kernel/config
	grep -qs ' /sys/kernel/config configfs ' /proc/mounts ||
		mount -t configfs configfs /sys/kernel/config || return 1
	wait_for_udc || {
		status 'UDC unavailable'
		return 1
	}
	status "UDC=$UDC"
	device_identity

	# A legacy g_ether instance cannot share the single MSM8916 UDC.
	rmmod g_ether 2>/dev/null || true
	gadget_remove

	mkdir -p "$GADGET/strings/0x409"
	mkdir -p "$GADGET/configs/c.1/strings/0x409"
	mkdir -p "$GADGET/functions/rndis.usb0"

	printf '%s\n' 0x1d6b > "$GADGET/idVendor"
	printf '%s\n' 0x0104 > "$GADGET/idProduct"
	printf '%s\n' 0x0200 > "$GADGET/bcdUSB"
	printf '%s\n' 0xef > "$GADGET/bDeviceClass"
	printf '%s\n' 0x02 > "$GADGET/bDeviceSubClass"
	printf '%s\n' 0x01 > "$GADGET/bDeviceProtocol"
	printf '%s\n' "$USB_SERIAL" > "$GADGET/strings/0x409/serialnumber"
	printf '%s\n' OpenWrt > "$GADGET/strings/0x409/manufacturer"
	printf '%s\n' 'UFI001B RNDIS' > "$GADGET/strings/0x409/product"
	printf '%s\n' 'RNDIS network' > "$GADGET/configs/c.1/strings/0x409/configuration"
	printf '%s\n' "$DEV_MAC" > "$GADGET/functions/rndis.usb0/dev_addr"
	printf '%s\n' "$HOST_MAC" > "$GADGET/functions/rndis.usb0/host_addr"

	# Microsoft OS 1.0 descriptor: makes Windows bind netrndis.inf automatically.
	printf '%s\n' 1 > "$GADGET/os_desc/use"
	printf '%s\n' 0xcd > "$GADGET/os_desc/b_vendor_code"
	printf '%s\n' MSFT100 > "$GADGET/os_desc/qw_sign"
	printf '%s\n' RNDIS > "$GADGET/functions/rndis.usb0/os_desc/interface.rndis/compatible_id"
	printf '%s\n' 5162001 > "$GADGET/functions/rndis.usb0/os_desc/interface.rndis/sub_compatible_id"
	ln -s "$GADGET/functions/rndis.usb0" "$GADGET/configs/c.1/rndis.usb0"
	ln -s "$GADGET/configs/c.1" "$GADGET/os_desc/c.1"

	# MSM8916 creates the RNDIS netdev only after the first UDC bind. Use that
	# bind to instantiate usb0, prepare the LAN, then rebind so the host sees an
	# already-running netdev during its final RNDIS initialization.
	printf '%s\n' "$UDC" > "$GADGET/UDC" || {
		status 'initial UDC bind failed'
		return 1
	}
	status 'initial UDC bound'
	wait_for_usb0 || {
		status 'usb0 unavailable after initial UDC bind'
		return 1
	}
	attach_lan_bridge 'initial-bind' 1 || return 1
	record_link_state 'initial-bind'
	printf '\n' > "$GADGET/UDC" || {
		status 'UDC unbind failed'
		return 1
	}
	status 'UDC unbound'
	sleep 1
	record_link_state 'unbound'
	printf '%s\n' "$UDC" > "$GADGET/UDC" || {
		status 'final UDC bind failed'
		return 1
	}
	status 'final UDC bound'
	sleep 3
	attach_lan_bridge 'final-bind' 0 || return 1
	record_link_state 'final-bind'
	(
		sleep 15
		record_link_state 'delayed-15s'
		sleep 45
		record_link_state 'delayed-60s'
	) &
}

stop() {
	board_is_ufi001b || return 0
	gadget_remove
}
