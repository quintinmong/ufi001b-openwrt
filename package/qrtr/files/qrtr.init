#!/bin/sh /etc/rc.common

# rc.common consumes these variables.
# shellcheck disable=SC2034
START=55
STOP=95
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/qrtr-ns -f 1
	procd_set_param respawn 3600 5 5
	procd_set_param oom_score_adj -500
	procd_close_instance
}
