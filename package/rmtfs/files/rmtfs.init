#!/bin/sh /etc/rc.common

# rc.common consumes these variables.
# shellcheck disable=SC2034
START=57
STOP=94
USE_PROCD=1

prepare_uio_link() {
	# BusyBox ash supports function-local variables.
	# shellcheck disable=SC3043
	local node name
	for node in /sys/class/uio/uio*; do
		[ -r "$node/name" ] || continue
		read -r name < "$node/name"
		[ "$name" = rmtfs ] || continue
		ln -snf "/dev/${node##*/}" /dev/qcom_rmtfs_uio1
		return 0
	done
	return 1
}

start_service() {
	prepare_uio_link || logger -t rmtfs "rmtfs UIO device is not present yet"
	procd_open_instance
	procd_set_param command /usr/bin/rmtfs -P -r -s
	procd_set_param respawn 3600 5 5
	procd_set_param oom_score_adj -500
	procd_close_instance
}
